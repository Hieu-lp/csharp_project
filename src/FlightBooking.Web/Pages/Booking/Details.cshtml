@page "{id:int}"
@model FlightBooking.Web.Pages.Booking.DetailsModel
@{ ViewData["Title"] = "Chi tiết hành trình"; }
@if (Model.Error is not null) { <div class="alert" role="alert">@Model.Error</div> }
@if (Model.Notice is not null) { <div class="notice" role="status">@Model.Notice</div> }
@if (Model.Bookings.Count > 0)
{
    var dauTien = Model.Bookings[0];
    <div class="page-heading"><span class="eyebrow">@(Model.Bookings.Count == 2 ? "HÀNH TRÌNH KHỨ HỒI" : "HÀNH TRÌNH MỘT CHIỀU")</span>
        <h1>@(Model.Bookings.All(b => b.TrangThai == "CANCELLED") ? "Hành trình đã hủy." : "Đã ghi nhận đặt vé.")</h1>
        <p>@dauTien.SoLuongVe hành khách · @Model.Bookings.Count lượt · @dauTien.NgayDat.ToString("dd/MM/yyyy HH:mm")</p></div>
    <div class="checkout-grid"><div>
    @for (var i = 0; i < Model.Bookings.Count; i++)
    {
        var datVe = Model.Bookings[i];
        <section class="panel"><span class="tag">@(i == 0 ? "Lượt đi" : "Lượt về") · Đơn #@datVe.MaDatVe</span>
        <h2>@datVe.ChuyenBay.ThanhPhoDi → @datVe.ChuyenBay.ThanhPhoDen</h2>
        <p>Đi: @datVe.ChuyenBay.NgayKhoiHanh.ToString("dd/MM/yyyy") @datVe.ChuyenBay.GioKhoiHanh.ToString("HH:mm")<br />Đến: @datVe.ChuyenBay.NgayDen.ToString("dd/MM/yyyy") @datVe.ChuyenBay.GioDen.ToString("HH:mm")</p>
        <p>@datVe.ChuyenBay.SanBayDi → @datVe.ChuyenBay.SanBayDen</p>
        <p>Đơn: @(datVe.TrangThai == "CANCELLED" ? "Đã hủy" : "Đã xác nhận") · Hóa đơn: @(datVe.TrangThaiHoaDon == "PAID" ? "Đã thanh toán" : datVe.TrangThaiHoaDon == "CANCELLED" ? "Đã hủy" : "Chưa thanh toán")</p>
        <div class="table-scroll"><table><caption>Hành khách và vé · @(i == 0 ? "Lượt đi" : "Lượt về")</caption><thead><tr><th>Hành khách</th><th>Giấy tờ</th><th>Vé / ghế</th><th>Hạng vé</th><th>Giá</th></tr></thead><tbody>
        @foreach (var chiTiet in datVe.ChiTiet)
        {
            <tr><td>@chiTiet.HoTenHanhKhach</td><td>@chiTiet.GiayToHanhKhach</td><td>#@chiTiet.MaVe · @chiTiet.SoGhe<br /><small>@(chiTiet.TrangThaiVe == "CANCELLED" ? "Đã hủy" : "Đã cấp")</small></td><td>@chiTiet.TenHangVe</td><td>@chiTiet.GiaVe.ToString("N2") ₫</td></tr>
        }
        </tbody></table></div><p>Giảm: @datVe.TienGiam.ToString("N2") ₫ · Thành tiền lượt: <strong>@datVe.TongTien.ToString("N2") ₫</strong></p></section>
    }
    <section class="panel"><h2>Khách đặt và thông tin tra cứu</h2><p>@dauTien.TenKhachHang · @dauTien.Email · @dauTien.SoDienThoai</p>
        <p>Lưu mã đơn lượt đi <strong>@dauTien.MaDatVe</strong> và khóa riêng để mở lại toàn bộ hành trình.</p>
        <details><summary>Hiện khóa tra cứu riêng</summary><code class="access-key">@Model.AccessKey</code></details><p class="muted">Không chia sẻ khóa: người giữ khóa có quyền xem và yêu cầu hủy.</p></section>
    </div><aside><section class="panel summary"><h2>Tổng hành trình</h2><dl class="amounts"><dt>Số lượt</dt><dd>@Model.Bookings.Count</dd><dt>Số vé</dt><dd>@Model.Bookings.Sum(b => b.SoLuongVe)</dd><dt class="total">Tổng tiền</dt><dd class="total">@Model.Bookings.Sum(b => b.TongTien).ToString("N2") ₫</dd></dl>
        <p class="muted">Đơn mới chưa thanh toán. Thanh toán và hoàn tiền do nhân viên xử lý.</p>
        @if (Model.Bookings.Any(b => b.TrangThai == "CONFIRMED") && Model.Bookings.Where(b => b.TrangThai == "CONFIRMED").All(b => b.TrangThaiHoaDon == "UNPAID"))
        {
            <details class="cancel"><summary>Yêu cầu hủy hành trình</summary><p>Hủy toàn bộ các lượt còn hiệu lực. Chỉ hủy đơn chưa thanh toán, trước giờ khởi hành.</p>
                <form method="post" asp-page-handler="Cancel" asp-route-id="@dauTien.MaDatVe"><button class="button danger full" type="submit">Xác nhận hủy toàn bộ hành trình</button></form></details>
        }
        <a class="button secondary full" asp-page="/Index">Tìm chuyến mới</a>
    </section></aside></div>
}
