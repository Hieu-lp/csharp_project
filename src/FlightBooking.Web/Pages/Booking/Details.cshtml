@page "{id:int}"
@model FlightBooking.Web.Pages.Booking.DetailsModel
@{ ViewData["Title"] = "Chi tiết hành trình"; }
@if (Model.Error is not null) { <div class="alert" role="alert">@Model.Error</div> }
@if (Model.Notice is not null) { <div class="notice" role="status">@Model.Notice</div> }
@if (Model.Bookings.Count > 0)
{
    var first = Model.Bookings[0];
    <div class="page-heading"><span class="eyebrow">@(Model.Bookings.Count == 2 ? "HÀNH TRÌNH KHỨ HỒI" : "HÀNH TRÌNH MỘT CHIỀU")</span>
        <h1>@(Model.Bookings.All(b => b.Status == "CANCELLED") ? "Hành trình đã hủy." : "Đã ghi nhận đặt vé.")</h1>
        <p>@first.TicketQuantity hành khách · @Model.Bookings.Count lượt · @first.BookingDate.ToString("dd/MM/yyyy HH:mm")</p></div>
    <div class="checkout-grid"><div>
    @for (var i = 0; i < Model.Bookings.Count; i++)
    {
        var booking = Model.Bookings[i];
        <section class="panel"><span class="tag">@(i == 0 ? "Lượt đi" : "Lượt về") · Đơn #@booking.BookingId</span>
        <h2>@booking.Flight.DepartureCity → @booking.Flight.ArrivalCity</h2>
        <p>Đi: @booking.Flight.DepartureDate.ToString("dd/MM/yyyy") @booking.Flight.DepartureTime.ToString("HH:mm")<br />Đến: @booking.Flight.ArrivalDate.ToString("dd/MM/yyyy") @booking.Flight.ArrivalTime.ToString("HH:mm")</p>
        <p>@booking.Flight.DepartureAirport → @booking.Flight.ArrivalAirport</p>
        <p>Đơn: @(booking.Status == "CANCELLED" ? "Đã hủy" : "Đã xác nhận") · Hóa đơn: @(booking.InvoiceStatus == "PAID" ? "Đã thanh toán" : booking.InvoiceStatus == "CANCELLED" ? "Đã hủy" : "Chưa thanh toán")</p>
        <div class="table-scroll"><table><caption>Hành khách và vé · @(i == 0 ? "Lượt đi" : "Lượt về")</caption><thead><tr><th>Hành khách</th><th>Giấy tờ</th><th>Vé / ghế</th><th>Hạng vé</th><th>Giá</th></tr></thead><tbody>
        @foreach (var detail in booking.Details)
        {
            <tr><td>@detail.PassengerFullName</td><td>@detail.PassengerIdCard</td><td>#@detail.TicketId · @detail.SeatNumber<br /><small>@(detail.TicketStatus == "CANCELLED" ? "Đã hủy" : "Đã cấp")</small></td><td>@detail.ClassName</td><td>@detail.Price.ToString("N0") ₫</td></tr>
        }
        </tbody></table></div><p>Giảm: @booking.DiscountAmount.ToString("N0") ₫ · Thành tiền lượt: <strong>@booking.TotalAmount.ToString("N0") ₫</strong></p></section>
    }
    <section class="panel"><h2>Khách đặt và thông tin tra cứu</h2><p>@first.CustomerName · @first.Email · @first.Phone</p>
        <p>Lưu mã đơn lượt đi <strong>@first.BookingId</strong> và khóa riêng để mở lại toàn bộ hành trình.</p>
        <details><summary>Hiện khóa tra cứu riêng</summary><code class="access-key">@Model.AccessKey</code></details><p class="muted">Không chia sẻ khóa: người giữ khóa có quyền xem và yêu cầu hủy.</p></section>
    </div><aside><section class="panel summary"><h2>Tổng hành trình</h2><dl class="amounts"><dt>Số lượt</dt><dd>@Model.Bookings.Count</dd><dt>Số vé</dt><dd>@Model.Bookings.Sum(b => b.TicketQuantity)</dd><dt class="total">Tổng tiền</dt><dd class="total">@Model.Bookings.Sum(b => b.TotalAmount).ToString("N0") ₫</dd></dl>
        <p class="muted">Đơn mới chưa thanh toán. Thanh toán và hoàn tiền do nhân viên xử lý.</p>
        @if (Model.Bookings.Any(b => b.Status == "CONFIRMED") && Model.Bookings.Where(b => b.Status == "CONFIRMED").All(b => b.InvoiceStatus == "UNPAID"))
        {
            <details class="cancel"><summary>Yêu cầu hủy hành trình</summary><p>Hủy toàn bộ các lượt còn hiệu lực. Chỉ hủy đơn chưa thanh toán, trước giờ khởi hành.</p>
                <form method="post" asp-page-handler="Cancel" asp-route-id="@first.BookingId"><button class="button danger full" type="submit">Xác nhận hủy toàn bộ hành trình</button></form></details>
        }
        <a class="button secondary full" asp-page="/Index">Tìm chuyến mới</a>
    </section></aside></div>
}
