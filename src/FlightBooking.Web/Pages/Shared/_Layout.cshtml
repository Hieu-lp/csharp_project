<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · FlightBooking</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a href="#main" class="skip-link">Đến nội dung chính</a>
    <header class="header"><div class="container header-inner">
        <a class="brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true">↗</span>Flight<span>Booking</span></a>
        <nav aria-label="Điều hướng chính"><a asp-page="/Index">Đặt vé</a><a asp-page="/Booking/Lookup">Tra cứu đơn đặt</a></nav>
    </div></header>
    <main id="main" class="container">@RenderBody()</main>
    <footer class="container footer"><span>FlightBooking · Quản lý bán vé máy bay</span><a asp-page="/Privacy">Thông tin & quyền riêng tư</a></footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
